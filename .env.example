# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOURREF.supabase.co
# "Publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# "Secret key" (sb_secret_...) - server only, never exposed to the browser
SUPABASE_SECRET_KEY=sb_secret_xxx

# Canonical URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://accounting.wearekindred.church

# Intuit / QuickBooks Online (developer.intuit.com app keys)
INTUIT_CLIENT_ID=xxx
INTUIT_CLIENT_SECRET=xxx
# sandbox or production; use sandbox keys with sandbox, production keys with production
INTUIT_ENVIRONMENT=sandbox
# 32 bytes base64 for token encryption at rest: openssl rand -base64 32
QBO_TOKEN_KEY=xxx

# Shared secret for the intranet expense-form webhook (openssl rand -hex 32).
# Must match the "Webhook secret" in the Kindred Site System settings on
# admin.wearekindred.church.
INTRANET_WEBHOOK_SECRET=xxx
